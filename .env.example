# Clinical Trial Eligibility Engine — environment variables
# Copy to .env and fill in your own values. .env is gitignored. Keep it that way.

# ---------------------------------------------------------------------------
# Nebius — https://studio.nebius.ai/settings/api-keys
# ---------------------------------------------------------------------------
NEBIUS_API_KEY=your_nebius_api_key_here

# check the exact model strings in your Nebius dashboard first. they change,
# and a wrong string fails at the first call rather than at startup.
NEBIUS_MODEL=meta-llama/Llama-3.3-70B-Instruct

# per-stage overrides. leave any of them out and it falls back to NEBIUS_MODEL.
# extraction and parsing want speed. matching wants the reasoning model.
NEBIUS_MODEL_EXTRACT=meta-llama/Llama-3.3-70B-Instruct
NEBIUS_MODEL_PARSE=meta-llama/Llama-3.3-70B-Instruct
NEBIUS_MODEL_MATCH=nvidia/Llama-3_1-Nemotron-Ultra-253B-v1

# ---------------------------------------------------------------------------
# Throughput
# ---------------------------------------------------------------------------
# each trial fires 2 calls, so live requests = MATCH_CONCURRENCY * 2.
# 2 is the tested value. raising it is how you get rate-limited by Nebius.
MATCH_CONCURRENCY=2

# characters of trial eligibility text sent to the model. the rest is cut.
MAX_CRITERIA_CHARS=6000

# raising this does not fix Nemotron's unterminated <think> responses.
# measured identical body lengths at 4096 and 16384. see AUDIT.md C2.
MATCH_MAX_TOKENS=4096

# retries per scoring pass on rate limits and timeouts.
MATCH_RETRIES=3

# ---------------------------------------------------------------------------
# Supabase — project Settings → API. this is the anon key, not the service key.
# ---------------------------------------------------------------------------
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your_supabase_anon_jwt_key_here

# ---------------------------------------------------------------------------
# Frontend (Vite). only vars prefixed VITE_ reach the browser, so never put a
# key here. defaults to http://localhost:8000 if unset.
# ---------------------------------------------------------------------------
VITE_API_URL=http://localhost:8000
