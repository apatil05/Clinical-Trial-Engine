# Clinical Trial Eligibility Engine — Environment Variables
# Copy this file to .env and fill in your values before running.
# Never commit .env to git.

# Nebius API — get from https://studio.nebius.ai/settings/api-keys
# Verify the exact model string in your Nebius dashboard before running.
NEBIUS_API_KEY=your_nebius_api_key_here
NEBIUS_MODEL=meta-llama/Llama-3.3-70B-Instruct

# Throughput tuning (you have ~$100 Nebius credits — these defaults are aggressive but demo-friendly)
MAX_TRIALS=8
MATCH_CONCURRENCY=8
MAX_CRITERIA_CHARS=6000

# Supabase — get from your project Settings → API (anon JWT key)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your_supabase_anon_jwt_key_here
